# 后端 API 基础地址（浏览器可访问，故用 NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# 商家端应用标识（用于后端识别来源与埋点）
NEXT_PUBLIC_APP_NAME=merchant-web

# 服务端渲染时使用的内部 API 地址（容器/内网可访问）
INTERNAL_API_BASE_URL=http://localhost:8000/api

# 用户端入驻申请地址（Phase 1 商家端不做注册，登录页提示外链到用户端）
NEXT_PUBLIC_USER_WEB_URL=http://localhost:3000/account/merchant-apply
