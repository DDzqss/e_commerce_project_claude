# -------------------------------------------------------------------
# JD-Clone Backend — Environment Variables
# Copy to .env and fill in real values. DO NOT commit .env.
# -------------------------------------------------------------------

# ---- App meta ----
PROJECT_NAME=JD-Clone Backend
ENVIRONMENT=local            # local | dev | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---- Database (PostgreSQL, async driver) ----
DATABASE_URL=postgresql+asyncpg://jdclone:jdclone@localhost:5432/jdclone
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- MinIO / S3 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jdclone
MINIO_SECURE=false

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-please-generate-a-real-secret-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
