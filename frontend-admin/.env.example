# === 平台管理员后台环境变量示例 ===
# 复制到 .env.local 后按需修改，切勿提交真实密钥到仓库

# 后端 API 基础地址（不含尾部斜杠）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# 站点名称（用于 <title>、页头等文案）
NEXT_PUBLIC_SITE_NAME=JD-Clone Admin

# 是否启用开发调试面板（true/false）
NEXT_PUBLIC_ENABLE_DEBUG=false

# 图片资源 CDN 前缀（如接入 MinIO/OSS 后填写）
NEXT_PUBLIC_IMAGE_CDN=

# 静态资源 URL（默认与站点同域）
NEXT_PUBLIC_SITE_URL=http://localhost:3002
